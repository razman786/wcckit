          "query": "from(bucket: \"wcckit\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"wcckit_app_ucalls\" or r._measurement == \"wcckit_app_ustat\" or r._measurement == \"wcckit_app_uflow_summary\")\n  |> filter(fn: (r) => r._field == \"events_total\" or r._field == \"entry_events_total\" or r._field == \"return_events_total\" or r._field == \"parsed_events_total\" or r._field == \"unparsed_events_total\")\n  |> group(columns: [\"run_id\", \"pipeline\", \"_measurement\", \"_field\"])\n  |> sort(columns: [\"_time\"])\n"
        }
