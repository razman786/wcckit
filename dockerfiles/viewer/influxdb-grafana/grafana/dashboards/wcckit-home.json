      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "options": {
        "mode": "markdown",
        "content": "### Dashboards\n\n- [01 WCCKIT Pipeline Overview](/d/wcckit-overview)\n- [02 AMD μProf / AMDuProfPcm Dashboard](/d/wcckit-amd-uprof-dashboard)\n- [03 Intel® Performance Counter Monitor Dashboard](/d/wcckit-intel-pcm-dashboard)\n- [04 WCCKIT Profiles](/d/wcckit-profiles)\n"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "Disabled: No data"
        },
        "overrides": []
