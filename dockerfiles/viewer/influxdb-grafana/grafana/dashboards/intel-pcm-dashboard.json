      "title": "PCM Collector Exit Status",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "query": "from(bucket: \"wcckit\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"wcckit_collector_status\") |> filter(fn: (r) => r._field == \"exit_code\") |> keep(columns: [\"_time\", \"_value\", \"run_id\", \"pipeline\", \"tool\", \"pid\", \"vendor\"])",
          "refId": "A"
        }
      ],
      "description": "Intel PCM collector exit status by run. Zero means success; non-zero usually means unsupported CPU, missing permissions, or collector failure."
