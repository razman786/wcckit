      "id": 4,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "query": "markers = from(bucket: \"wcckit\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"wcckit_run_marker\")\n  |> filter(fn: (r) => r._field == \"value\" or r._field == \"job_lane\")\n  |> filter(fn: (r) => r.phase == \"start\" or r.phase == \"end\")\n  |> keep(columns: [\"_time\", \"run_id\", \"pipeline\", \"phase\", \"_field\", \"_value\"])\n  |> pivot(rowKey: [\"_time\", \"run_id\", \"pipeline\", \"phase\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> map(fn: (r) => ({_time: r._time, run_id: r.run_id, pipeline: r.pipeline, phase: r.phase, _value: if exists r.job_lane then float(v: r.job_lane) else 1.0, _field: \"job_lane\"}))\n\nstarts = markers\n  |> filter(fn: (r) => r.phase == \"start\")\n  |> rename(columns: {_time: \"start_time\"})\n  |> keep(columns: [\"run_id\", \"pipeline\", \"start_time\", \"_value\"])\n\nends = markers\n  |> filter(fn: (r) => r.phase == \"end\")\n  |> rename(columns: {_time: \"end_time\", _value: \"end_lane\"})\n  |> keep(columns: [\"run_id\", \"pipeline\", \"end_time\", \"end_lane\"])\n\njoined = join(tables: {start: starts, end: ends}, on: [\"run_id\", \"pipeline\"], method: \"inner\")\n\nstart_line = joined\n  |> map(fn: (r) => ({_time: r.start_time, _value: r._value, _field: \"job_lane\", run_id: r.run_id, pipeline: r.pipeline}))\n\nend_line = joined\n  |> map(fn: (r) => ({_time: r.end_time, _value: r.end_lane, _field: \"job_lane\", run_id: r.run_id, pipeline: r.pipeline}))\n\nunion(tables: [start_line, end_line])\n  |> group(columns: [\"run_id\", \"pipeline\"])\n  |> sort(columns: [\"_time\"])\n"
        }
      ],
      "title": "Run Start/End Timeline",
      "type": "timeseries",
      "description": "Each run is plotted as two points on a pipeline/job lane joined by a thin horizontal line. The y-axis is only a lane/counter; duration is read from the x-axis distance between start and end."
