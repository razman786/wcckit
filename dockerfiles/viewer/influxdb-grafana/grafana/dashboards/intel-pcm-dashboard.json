      "targets": [
        {
          "query": "from(bucket: \"wcckit\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"wcckit_pcm_cpu\") |> filter(fn: (r) => r._field == \"scrape_bytes\") |> last()",
          "refId": "A"
        }
      ],
      "description": "Last PCM scrape payload size. Non-empty scrape_bytes means the bridge is receiving sensor-server output."
